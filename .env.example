# Generate a complete private .env.local with scripts/configure_demo.py.
# No provider or database secrets belong in source control.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=novex-agent
DB_USER=novex_app
DB_PWD=GENERATE_LOCALLY
DB_SSLMODE=disable
HTTP_PORT=8310
REDIS_HOST=127.0.0.1
REDIS_PORT=18379
REDIS_DB=0
AUTH_JWT_SECRET=GENERATE_LOCALLY
AUTH_RSA_PRIVATE_KEY=GENERATE_PKCS8_BASE64_LOCALLY
BOOTSTRAP_ADMIN_PASSWORD=SET_A_DEMO_PASSWORD
NOVEX_ENCRYPTION_KEY=GENERATE_32_BYTES_BASE64_LOCALLY
NOVEX_RUNNER_SECRET=GENERATE_LOCALLY
NOVEX_RUNNER_URL=http://127.0.0.1:8320
NOVEX_MODEL_PROXY_URL=http://127.0.0.1:8330
NOVEX_MODEL_BASE_URL=https://api.b.ai/v1
NOVEX_MODEL_NAME=deepseek-v4.1-flash
NOVEX_MODEL_API_KEY=SET_PRIVATELY
NOVEX_HTTPS_PROXY=
NOVEX_PUBLIC_URL=http://host.docker.internal:8310
NOVEX_CHAT_ORIGINS=http://localhost:8312,http://127.0.0.1:8312
NOVEX_EMBED_PARENT_ORIGINS=http://localhost:8311,http://127.0.0.1:8311
NOVEX_HR_HOST=127.0.0.1
NOVEX_HR_PORT=5432
NOVEX_HR_DATABASE=novex-hr
NOVEX_HR_USER=novex_hr_read
NOVEX_HR_PASSWORD=GENERATE_LOCALLY
NOVEX_HARDWARE_HOST=127.0.0.1
NOVEX_HARDWARE_PORT=5432
NOVEX_HARDWARE_DATABASE=novex-hardware
NOVEX_HARDWARE_USER=novex_hardware_read
NOVEX_HARDWARE_PASSWORD=GENERATE_LOCALLY
